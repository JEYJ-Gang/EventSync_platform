generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organizer {
  id_organizer  Int    @id @default(autoincrement())
  full_name     String @db.VarChar(150)
  email         String @unique @db.VarChar(150)
  password_hash String @db.Text
  role          String @default("ADMIN")

  @@map("organizer")
}

model Event {
  id_event    Int       @id @default(autoincrement())
  title       String    @db.VarChar(150)
  description String?
  start_date  DateTime
  end_date    DateTime
  location    String?   @db.VarChar(150)
  sessions    Session[]

  @@map("event")
}

model Room {
  id_room  Int       @id @default(autoincrement())
  name     String    @db.VarChar(50)
  capacity Int?
  sessions Session[]

  @@map("room")
}

model Speaker {
  id_speaker    Int         @id @default(autoincrement())
  first_name    String      @db.VarChar(150)
  last_name     String      @db.VarChar(150)
  photo_url     String?
  biography     String?
  external_link String?
  intervenes    Intervene[]

  @@map("speaker")
}

model Session {
  id_session      Int         @id @default(autoincrement())
  title           String      @db.VarChar(150)
  description     String?
  start_time      DateTime    @db.Time(6)
  end_time        DateTime    @db.Time(6)
  max_participant Int?
  id_room         Int
  id_event        Int
  intervenes      Intervene[]
  questions       Question[]
  event           Event       @relation(fields: [id_event], references: [id_event], onDelete: Cascade)
  room            Room        @relation(fields: [id_room], references: [id_room])

  @@map("session")
}

model Question {
  id_question       Int      @id @default(autoincrement())
  content           String
  author_name       String?  @db.VarChar(50)
  upvote            Int      @default(0)
  creation_datetime DateTime @default(now())
  id_session        Int?
  session           Session? @relation(fields: [id_session], references: [id_session])

  @@map("question")
}

model Intervene {
  id_session Int
  id_speaker Int
  session    Session @relation(fields: [id_session], references: [id_session], onDelete: Cascade)
  speaker    Speaker @relation(fields: [id_speaker], references: [id_speaker], onDelete: Cascade)

  @@id([id_session, id_speaker])
  @@map("intervene")
}
